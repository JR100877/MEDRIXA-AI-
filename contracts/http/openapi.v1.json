{
  "components": {
    "schemas": {
      "ClinicalCase": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Case Id",
            "type": "string"
          },
          "history_available": {
            "title": "History Available",
            "type": "boolean"
          },
          "observations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "maxItems": 100,
            "title": "Observations",
            "type": "array"
          },
          "schema_version": {
            "const": "medrixa.prototype.v1",
            "default": "medrixa.prototype.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "source": {
            "const": "synthetic_fixture",
            "title": "Source",
            "type": "string"
          },
          "synthetic": {
            "const": true,
            "title": "Synthetic",
            "type": "boolean"
          }
        },
        "required": [
          "synthetic",
          "source",
          "history_available"
        ],
        "title": "ClinicalCase",
        "type": "object"
      },
      "CreateRunRequest": {
        "additionalProperties": false,
        "description": "POST /v1/runs body. ``case.case_id`` is mandatory over HTTP (no server default),\nso a retried request is byte-for-byte comparable for idempotency.",
        "properties": {
          "case": {
            "$ref": "#/components/schemas/ClinicalCase"
          }
        },
        "required": [
          "case"
        ],
        "title": "CreateRunRequest",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_INPUT",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "IDEMPOTENCY_KEY_REQUIRED",
              "IDEMPOTENCY_KEY_REUSED",
              "IDEMPOTENCY_IN_PROGRESS",
              "CONFLICT",
              "RUNS_ACTIVE",
              "STORE_UNAVAILABLE",
              "STORE_INTEGRITY_ERROR",
              "AUDIT_UNAVAILABLE",
              "INTERNAL_ERROR",
              "RATE_LIMITED",
              "CAPACITY_EXCEEDED",
              "NOT_READY"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 200,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "medrixa.http.v1",
            "default": "medrixa.http.v1",
            "title": "Api Version",
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthView": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "medrixa.http.v1",
            "default": "medrixa.http.v1",
            "title": "Api Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthView",
        "type": "object"
      },
      "Observation": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Code",
            "type": "string"
          },
          "schema_version": {
            "const": "medrixa.prototype.v1",
            "default": "medrixa.prototype.v1",
            "title": "Schema Version",
            "type": "string"
          },
          "source": {
            "const": "synthetic_fixture",
            "default": "synthetic_fixture",
            "title": "Source",
            "type": "string"
          },
          "unit": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "code",
          "value",
          "unit"
        ],
        "title": "Observation",
        "type": "object"
      },
      "ReadyView": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "medrixa.http.v1",
            "default": "medrixa.http.v1",
            "title": "Api Version",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadyView",
        "type": "object"
      },
      "RecoveryView": {
        "additionalProperties": false,
        "properties": {
          "active_elsewhere": {
            "default": 0,
            "description": "P6: running runs skipped because their executor holds a live lease. Omitted when 0.",
            "minimum": 0.0,
            "title": "Active Elsewhere",
            "type": "integer"
          },
          "agents_reexecuted": {
            "const": 0,
            "default": 0,
            "title": "Agents Reexecuted",
            "type": "integer"
          },
          "already_terminal": {
            "minimum": 0.0,
            "title": "Already Terminal",
            "type": "integer"
          },
          "api_version": {
            "const": "medrixa.http.v1",
            "default": "medrixa.http.v1",
            "title": "Api Version",
            "type": "string"
          },
          "corrupt_records": {
            "minimum": 0.0,
            "title": "Corrupt Records",
            "type": "integer"
          },
          "moved_to_review": {
            "minimum": 0.0,
            "title": "Moved To Review",
            "type": "integer"
          },
          "not_started": {
            "minimum": 0.0,
            "title": "Not Started",
            "type": "integer"
          }
        },
        "required": [
          "moved_to_review",
          "not_started",
          "already_terminal",
          "corrupt_records"
        ],
        "title": "RecoveryView",
        "type": "object"
      },
      "RunEventView": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "kind": {
            "enum": [
              "RUN_STARTED",
              "AGENT_DISPATCHED",
              "RESULT_ACCEPTED",
              "REVIEW_REQUESTED"
            ],
            "title": "Kind",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "REVIEW_REQUIRED",
                  "MISSING_DATA",
                  "UNKNOWN_ROUTE",
                  "AGENT_ERROR",
                  "INVALID_RESULT",
                  "TIMEOUT",
                  "CANCELLED",
                  "STEP_LIMIT",
                  "INVALID_PLAN",
                  "INTERNAL_ERROR",
                  "INTERRUPTED"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "sequence": {
            "minimum": 1.0,
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "sequence",
          "kind",
          "at"
        ],
        "title": "RunEventView",
        "type": "object"
      },
      "RunEventsView": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "medrixa.http.v1",
            "default": "medrixa.http.v1",
            "title": "Api Version",
            "type": "string"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/RunEventView"
            },
            "title": "Events",
            "type": "array"
          },
          "run_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "events"
        ],
        "title": "RunEventsView",
        "type": "object"
      },
      "RunView": {
        "additionalProperties": false,
        "properties": {
          "abstained": {
            "minimum": 0.0,
            "title": "Abstained",
            "type": "integer"
          },
          "api_version": {
            "const": "medrixa.http.v1",
            "default": "medrixa.http.v1",
            "title": "Api Version",
            "type": "string"
          },
          "case_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Case Id",
            "type": "string"
          },
          "completed": {
            "minimum": 0.0,
            "title": "Completed",
            "type": "integer"
          },
          "dispatched": {
            "minimum": 0.0,
            "title": "Dispatched",
            "type": "integer"
          },
          "failed": {
            "minimum": 0.0,
            "title": "Failed",
            "type": "integer"
          },
          "human_review_required": {
            "const": true,
            "default": true,
            "title": "Human Review Required",
            "type": "boolean"
          },
          "revision": {
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "run_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "created",
              "running",
              "awaiting_human_review"
            ],
            "title": "Status",
            "type": "string"
          },
          "stop_reason": {
            "anyOf": [
              {
                "enum": [
                  "REVIEW_REQUIRED",
                  "MISSING_DATA",
                  "UNKNOWN_ROUTE",
                  "AGENT_ERROR",
                  "INVALID_RESULT",
                  "TIMEOUT",
                  "CANCELLED",
                  "STEP_LIMIT",
                  "INVALID_PLAN",
                  "INTERNAL_ERROR",
                  "INTERRUPTED"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Reason"
          }
        },
        "required": [
          "run_id",
          "case_id",
          "status",
          "stop_reason",
          "revision",
          "dispatched",
          "completed",
          "abstained",
          "failed"
        ],
        "title": "RunView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "Bearer token: OIDC access token (JWT, MEDRIXA_AUTH_MODE=oidc) or the provisional local HMAC token (mdx1, development/test).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Local synthetic-data simulator. Not a medical device; no clinical validation. All results require human review.",
    "title": "MEDRIXA AI — local API (provisional)",
    "version": "medrixa.http.v1"
  },
  "openapi": "3.1.0",
