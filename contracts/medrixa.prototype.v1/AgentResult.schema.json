{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "medrixa.prototype.v1",
          "default": "medrixa.prototype.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "enum": [
            "HISTORY_PRESENT",
            "HISTORY_MISSING",
            "OBSERVATIONS_PRESENT",
            "OBSERVATIONS_MISSING",
            "SYNTHETIC_ONLY"
          ],
          "title": "Code",
          "type": "string"
        },
        "source": {
          "const": "synthetic_completeness_rule",
          "default": "synthetic_completeness_rule",
          "title": "Source",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "rule_id"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "medrixa.prototype.v1",
      "default": "medrixa.prototype.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "result_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Result Id",
      "type": "string"
    },
    "message_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Message Id",
      "type": "string"
    },
    "case_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "agent_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Agent Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "abstained",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "maxItems": 100,
      "title": "Findings",
      "type": "array"
    },
    "requires_human_review": {
      "const": true,
      "default": true,
      "title": "Requires Human Review",
      "type": "boolean"
    }
  },
  "required": [
    "message_id",
    "case_id",
    "run_id",
    "agent_id",
    "status"
  ],
  "title": "AgentResult",
  "type": "object"
}
